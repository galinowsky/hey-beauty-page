---
import Page from "../../layouts/Page.astro";
import { getCollection } from "astro:content";
import ServiceCard from "../../components/ServiceCard.astro";

const services = await getCollection("services");
const sorted = services.sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const title = "Usługi — Zabiegi Kosmetyczne Hey Beauty Kraków";
const description =
  "Pełna oferta zabiegów kosmetycznych Hey Beauty: stylizacja brwi, lifting rzęs, pedicure, radiofrekwencja, mezoterapia, dermapen i więcej. Sprawdź ceny i umów wizytę.";
const breadcrumbs = [
  { name: "Strona główna", url: "/" },
  { name: "Usługi", url: "/uslugi/" },
];
---

<Page {title} {description} {breadcrumbs}>
  <section class="py-16 lg:py-24">
    <h1 class="font-display text-h1">Usługi</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Profesjonalne zabiegi kosmetyczne w 4 salonach Hey Beauty w Krakowie.
    </p>
    <div
      class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        sorted.map((s) => (
          <ServiceCard
            name={s.data.name}
            slug={s.data.slug}
            description={s.data.description}
            priceMin={s.data.priceRange.min}
            duration={`${s.data.duration.min} min`}
            image={s.data.image}
          />
        ))
      }
    </div>
  </section>
</Page>
