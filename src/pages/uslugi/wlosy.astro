---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import JsonLd from "../../components/JsonLd.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import { buildBreadcrumbList, buildFAQPage } from "../../lib/json-ld";
import { getCollection } from "astro:content";
import { assetPath, url } from "../../utils/asset";

const allFaq = await getCollection("faq");
const hairFaq = allFaq.find((f) => f.data.scope === "service" && f.data.scopeSlug === "wlosy");

const title = "Keratynowe Zabiegi Włosów Kraków — Magdalena Tryba | Hey Beauty Zabłocie";
const description =
  "Prostowanie i regeneracja keratynowa włosów w Krakowie. Specjalistka Magdalena Tryba — efekt do 5 miesięcy. Hey Beauty Zabłocie, ul. Przemysłowa 4. Umów online.";

const breadcrumbs = [
  { name: "Strona główna", url: "/" },
  { name: "Usługi", url: "/uslugi/" },
  { name: "Włosy", url: "/uslugi/wlosy/" },
];

const services = [
  {
    name: "Keratynowe prostowanie włosów",
    desc: "Trwałe wygładzenie włosów na 3–5 miesięcy. Eliminuje puszenie, skraca czas suszenia o 60%. Formuła bezformaldehydowa — bezpieczna dla każdego rodzaju włosa.",
    duration: "2,5–4 h",
    price: "od 450 zł",
    note: "Cena zależy od długości i grubości włosów",
  },
  {
    name: "Keratynowa regeneracja włosów",
    desc: "Intensywna odbudowa struktury włosa od wewnątrz. Efekt miękkości, blasku i elastyczności. Idealna dla włosów zniszczonych farbowaniem i stylizacją.",
    duration: "2–3 h",
    price: "od 350 zł",
    note: "Cena zależy od długości i grubości włosów",
  },
];

const reviews = [
  {
    text: "Polecam usługi Madzi, włosy po keratynie wyglądają jak milion dolarów :)",
    name: "Izabela",
    service: "Keratynowe prostowanie",
    rating: 5,
  },
  {
    text: "Magdalena podeszła do moich włosów z ogromną troską i wiedzą. Efekt przeszedł moje oczekiwania — włosy są gładkie, lśniące i bez puszenia. Na pewno wrócę.",
    name: "Ewelina",
    service: "Keratynowa regeneracja",
    rating: 5,
  },
  {
    text: "Byłam sceptyczna, bo mam bardzo grube i oporne włosy. Madzii udało się to, czego nie mogły zrobić poprzednie salony. Absolutna profesjonalistka.",
    name: "Lisa",
    service: "Keratynowe prostowanie",
    rating: 5,
  },
];
---

<Base {title} {description}>
  <JsonLd slot="head" data={buildBreadcrumbList(breadcrumbs, Astro.site)} />
  {hairFaq && <JsonLd slot="head" data={buildFAQPage(hairFaq.data.items)} />}

  <!-- Breadcrumbs -->
  <div class="mx-auto max-w-7xl px-6 pt-8">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- ── HERO — full-bleed editorial dark with video background ── -->
  <section class="relative overflow-hidden bg-[#0a0a0a] py-32 lg:py-48">

    <!-- Video background — 3 clips rotating at low opacity -->
    {[
      assetPath("/videos/madzia/hair-1.mp4"),
      assetPath("/videos/madzia/hair-2.mp4"),
      assetPath("/videos/madzia/hair-3.mp4"),
    ].map((src, i) => (
      <video
        data-hero-video
        src={src}
        autoplay
        muted
        loop
        playsinline
        class:list={[
          "absolute inset-0 h-full w-full object-cover transition-opacity duration-[1500ms]",
          i === 0 ? "opacity-[0.22]" : "opacity-0",
        ]}
        aria-hidden="true"
      />
    ))}

    <!-- Dark overlay so text stays crisp -->
    <div class="pointer-events-none absolute inset-0 bg-[#0a0a0a]/60"></div>

    <!-- Subtle noise grain on top -->
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.04]"
      style="background-image:url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\"); background-size:256px;"
    ></div>

    <div class="relative mx-auto max-w-7xl px-6" style="z-index:2">
      <p class="font-ui text-[11px] uppercase tracking-[6px] text-white/30">
        Hey Beauty Zabłocie &middot; Usługi
      </p>
      <h1
        class="mt-6 font-display text-[clamp(5rem,15vw,12rem)] italic leading-[0.9] tracking-tight text-white"
      >
        Włosy
      </h1>
      <p class="mt-8 max-w-lg font-body text-lg leading-relaxed text-white/50">
        Keratynowe zabiegi prostujące i regenerujące. Efekt, który widać od pierwszego
        mycia — i zostaje z Tobą na miesiące.
      </p>
      <div class="mt-12 flex flex-wrap items-center gap-6">
        <a
          href="https://booksy.com/pl-pl/306187_hey-beauty-zablocie_salon-kosmetyczny_8820_krakow"
          target="_blank"
          rel="noopener"
          class="inline-block border border-white/20 bg-white px-10 py-4 font-ui text-[12px] uppercase tracking-[4px] text-black transition-all hover:bg-white/90"
        >
          Umów wizytę
        </a>
        <span class="font-mono text-xs tracking-[2px] text-white/30">
          ★★★★★ &nbsp;·&nbsp; Zweryfikowane opinie Booksy
        </span>
      </div>
    </div>
  </section>

  <script>
    const heroVideos = document.querySelectorAll<HTMLVideoElement>("[data-hero-video]");
    let current = 0;

    setInterval(() => {
      heroVideos[current].classList.remove("opacity-[0.22]");
      heroVideos[current].classList.add("opacity-0");
      current = (current + 1) % heroVideos.length;
      heroVideos[current].classList.remove("opacity-0");
      heroVideos[current].classList.add("opacity-[0.22]");
    }, 5000);
  </script>

  <!-- ── MAGDALENA — expert card ── -->
  <section class="bg-[#f6f5f3]">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:py-32">
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-[1fr_1.6fr] lg:items-center">

        <!-- Portrait -->
        <div class="relative">
          <div class="aspect-[3/4] overflow-hidden">
            <img
              src={assetPath("/images/team/madzia.jpg")}
              alt="Magdalena Tryba — specjalistka zabiegów keratynowych Hey Beauty"
              class="h-full w-full object-cover object-top grayscale"
            />
          </div>
          <!-- Floating badge -->
          <div
            class="absolute -bottom-4 -right-4 border border-border bg-white px-5 py-3 shadow-sm"
          >
            <p class="font-ui text-[10px] uppercase tracking-[3px] text-muted">Certyfikowany</p>
            <p class="font-display text-base">Specjalista Keratyny</p>
          </div>
        </div>

        <!-- Bio -->
        <div>
          <p class="font-ui text-[11px] uppercase tracking-[4px] text-muted">
            Twoja specjalistka
          </p>
          <h2 class="mt-4 font-display text-h1 leading-[1]">Magdalena</h2>
          <p class="mt-1 font-ui text-[13px] uppercase tracking-[3px] text-muted">Tryba</p>

          <p class="mt-10 text-lg leading-relaxed text-muted">
            Magdalena od lat pasjonuje się keratyną — nie jako prostą usługą, ale
            jako sztuką transformacji włosa. Każdy zabieg traktuje indywidualnie:
            dobiera formułę, czas aplikacji i pielęgnację do konkretnego rodzaju
            włosa i oczekiwań klientki.
          </p>
          <p class="mt-5 text-lg leading-relaxed text-muted">
            Certyfikowany specjalista keratynowego prostowania i regeneracji.
            Pracuje wyłącznie ze sprawdzonymi preparatami bezformaldehydowymi.
            Znajdziesz ją w Hey Beauty Zabłocie.
          </p>

          <!-- Stats row -->
          <div class="mt-12 flex gap-12 border-t border-border pt-10">
            <div>
              <p class="font-display text-4xl">5★</p>
              <p class="mt-1 font-ui text-[11px] uppercase tracking-[2px] text-muted">
                Średnia ocen
              </p>
            </div>
            <div>
              <p class="font-display text-4xl">3–5</p>
              <p class="mt-1 font-ui text-[11px] uppercase tracking-[2px] text-muted">
                Miesiące efektu
              </p>
            </div>
            <div>
              <p class="font-display text-4xl italic">∞</p>
              <p class="mt-1 font-ui text-[11px] uppercase tracking-[2px] text-muted">
                Pasja do włosa
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SERVICES — two keratin offerings ── -->
  <section class="py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6">
      <div>
        <p class="font-ui text-[11px] uppercase tracking-[4px] text-muted">Oferta</p>
        <h2 class="mt-4 font-display text-h2">Zabiegi keratynowe</h2>
        <p class="mt-3 font-mono text-xs tracking-[2px] text-muted/60">
          Dostępne wyłącznie w salonie Hey Beauty Zabłocie
        </p>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-0 divide-y divide-border border-t border-b border-border lg:grid-cols-2 lg:divide-y-0 lg:divide-x">
        {
          services.map((s) => (
            <div class="p-6 lg:p-8">
              <h3 class="font-display text-2xl">{s.name}</h3>
              <p class="mt-5 text-base leading-relaxed text-muted">{s.desc}</p>
              <div class="mt-8 flex items-baseline gap-8">
                <div>
                  <p class="font-ui text-[10px] uppercase tracking-[2px] text-muted">Cena</p>
                  <p class="mt-1 font-display text-3xl">{s.price}</p>
                  <p class="mt-1 text-xs text-muted/60">{s.note}</p>
                </div>
                <div>
                  <p class="font-ui text-[10px] uppercase tracking-[2px] text-muted">Czas</p>
                  <p class="mt-1 font-display text-3xl">{s.duration}</p>
                </div>
              </div>
              <a
                href="https://booksy.com/pl-pl/306187_hey-beauty-zablocie_salon-kosmetyczny_8820_krakow"
                target="_blank"
                rel="noopener"
                class="mt-8 inline-block border border-primary px-8 py-3 font-ui text-[11px] uppercase tracking-[3px] transition-colors hover:bg-primary hover:text-white"
              >
                Umów →
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── VIDEO REEL — full-bleed cinematic strip ── -->
  <section class="overflow-hidden bg-[#0a0a0a] py-20">
    <div class="mb-12 px-6">
      <p class="font-ui text-[11px] uppercase tracking-[4px] text-white/30">
        Praca Magdaleny
      </p>
      <h2 class="mt-3 font-display text-h2 italic text-white">
        Efekty mówią same za siebie
      </h2>
    </div>

    <!-- Horizontal scroll reel -->
    <div
      class="flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-6 scrollbar-none"
      style="scroll-padding-left: 1.5rem; -webkit-overflow-scrolling: touch;"
    >
      {
        [
          assetPath("/videos/madzia/hair-1.mp4"),
          assetPath("/videos/madzia/hair-2.mp4"),
          assetPath("/videos/madzia/hair-3.mp4"),
        ].map((src, i) => (
          <div
            class="relative flex-none snap-start overflow-hidden"
            style="width: min(72vw, 320px); aspect-ratio: 9/16;"
          >
            <video
              src={src}
              autoplay
              muted
              loop
              playsinline
              class="h-full w-full object-cover"
              aria-label={`Film z pracy Magdaleny ${i + 1}`}
            />
            <!-- Subtle bottom vignette -->
            <div
              class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3"
              style="background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);"
            ></div>
            <p class="absolute bottom-4 left-4 font-mono text-[10px] tracking-[2px] text-white/50">
              0{i + 1} / 03
            </p>
          </div>
        ))
      }

      <!-- Right padding ghost element -->
      <div class="flex-none" style="width: 1.5rem;"></div>
    </div>

    <!-- Scroll hint -->
    <p class="mt-6 px-6 font-mono text-[10px] tracking-[3px] text-white/20">
      ← przesuń →
    </p>
  </section>

  <!-- ── REVIEWS ── -->
  <section class="py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6">
      <div class="text-center">
        <p class="font-ui text-[11px] uppercase tracking-[4px] text-muted">
          Opinie klientek
        </p>
        <h2 class="mt-4 font-display text-h2">Co mówią o Magdalenie</h2>
        <p class="mt-3 font-mono text-xs tracking-[2px] text-muted">
          ★★★★★ &nbsp;·&nbsp; Zweryfikowane opinie z Booksy
        </p>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          reviews.map((r) => (
            <div class="flex flex-col border border-border p-8">
              <p class="font-display text-3xl leading-none text-muted/20">&ldquo;</p>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{r.text}</p>
              <div class="mt-6 border-t border-border pt-6">
                <p class="font-ui text-[13px] font-medium">{r.name}</p>
                <p class="mt-0.5 font-ui text-[11px] uppercase tracking-[2px] text-muted">
                  {r.service}
                </p>
                <p class="mt-1 text-xs text-muted/60">{"★".repeat(r.rating)}</p>
              </div>
            </div>
          ))
        }
      </div>

      <p class="mt-10 text-center font-mono text-xs tracking-[2px] text-muted/50">
        Źródło: Booksy — zweryfikowane opinie potwierdzonych klientek
      </p>
    </div>
  </section>

  <!-- ── FAQ ── -->
  {hairFaq && (
    <section class="py-24 lg:py-32">
      <div class="mx-auto max-w-3xl px-6">
        <div class="text-center">
          <p class="font-ui text-[11px] uppercase tracking-[4px] text-muted">FAQ</p>
          <h2 class="mt-4 font-display text-h2">Najczęściej zadawane pytania</h2>
        </div>
        <div class="mt-16">
          <FAQAccordion items={hairFaq.data.items} />
        </div>
      </div>
    </section>
  )}

  <!-- ── BOOKING CTA — dark strip ── -->
  <section class="bg-[#0a0a0a] px-6 py-24 text-center">
    <p class="font-ui text-[11px] uppercase tracking-[4px] text-white/30">
      Hey Beauty Zabłocie
    </p>
    <h2 class="mt-4 font-display text-[clamp(2rem,5vw,3.5rem)] italic text-white">
      Gotowa na nowe włosy?
    </h2>
    <p class="mt-4 font-body text-base text-white/40">
      ul. Przemysłowa 4/469, Kraków-Zabłocie &nbsp;·&nbsp; pon–pt 9–20, sob 9–16
    </p>
    <a
      href="https://booksy.com/pl-pl/306187_hey-beauty-zablocie_salon-kosmetyczny_8820_krakow"
      target="_blank"
      rel="noopener"
      class="mt-10 inline-block border border-white/20 bg-white px-12 py-5 font-ui text-[12px] uppercase tracking-[5px] text-black transition-all hover:bg-white/90"
    >
      Umów wizytę online
    </a>
  </section>

  <!-- ── BACK TO SERVICES link ── -->
  <div class="mx-auto max-w-7xl px-6 py-12">
    <a
      href={url("/uslugi/")}
      class="font-ui text-[11px] uppercase tracking-[3px] text-muted hover:text-primary"
    >
      ← Wszystkie usługi
    </a>
  </div>
</Base>

<style>
  .scrollbar-none {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>
