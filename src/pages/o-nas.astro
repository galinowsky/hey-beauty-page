---
import Page from "../layouts/Page.astro";
import BookingCTA from "../components/BookingCTA.astro";
import { getCollection } from "astro:content";

const specialists = await getCollection("specialists");
const locations = await getCollection("locations");

const sortedSpecialists = [...specialists].sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);

const locationName: Record<string, string> = Object.fromEntries(
  locations.map((l) => [l.data.slug, l.data.shortName]),
);

const title = "O Hey Beauty — Salon Kosmetyczny Kraków";
const description =
  "Poznaj Hey Beauty. Sieć salonów kosmetycznych w Krakowie łączących profesjonalizm z luksusową atmosferą. 4 lokalizacje, doświadczony zespół, najwyższa jakość.";
const breadcrumbs = [
  { name: "Strona główna", url: "/" },
  { name: "O nas", url: "/o-nas/" },
];
---

<Page {title} {description} {breadcrumbs}>
  <!-- Hero -->
  <section class="pb-12 pt-16 lg:pt-24">
    <p class="font-ui text-[11px] uppercase tracking-[3px] text-muted">O nas</p>
    <h1 class="mt-3 font-display text-h1">Hey Beauty</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">
      Sieć salonów kosmetycznych w Krakowie, łączących profesjonalizm
      z luksusową atmosferą. Pełen zakres usług — od stylizacji brwi i rzęs,
      przez zabiegi pielęgnacyjne, po manicure i pedicure.
    </p>
  </section>

  <!-- Philosophy + Why us -->
  <section class="border-t border-border py-16">
    <div class="grid grid-cols-1 gap-16 md:grid-cols-2">
      <div>
        <p class="font-ui text-[11px] uppercase tracking-[3px] text-muted">
          Nasza filozofia
        </p>
        <h2 class="mt-3 font-display text-h3">Luksus w codzienności</h2>
        <p class="mt-4 leading-relaxed text-muted">
          Wierzymy, że każda kobieta zasługuje na chwilę luksusu. Nasze salony
          inspirowane są stylem &ldquo;Soft Industrial Luxury&rdquo; —
          połączeniem surowych materiałów z ciepłem i elegancją.
        </p>
      </div>
      <div>
        <p class="font-ui text-[11px] uppercase tracking-[3px] text-muted">
          Dlaczego my?
        </p>
        <h2 class="mt-3 font-display text-h3">Jakość ponad wszystko</h2>
        <ul class="mt-4 space-y-3 text-muted">
          <li class="flex items-start gap-3">
            <span class="mt-0.5 font-ui text-[10px] uppercase tracking-[2px] text-primary">★</span>
            <span>5.0 na Booksy — setki opinii</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 font-ui text-[10px] uppercase tracking-[2px] text-primary">→</span>
            <span>4 lokalizacje w centrum Krakowa</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 font-ui text-[10px] uppercase tracking-[2px] text-primary">→</span>
            <span>Profesjonalny zespół specjalistek</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 font-ui text-[10px] uppercase tracking-[2px] text-primary">→</span>
            <span>Darmowa konsultacja kosmetologiczna</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 font-ui text-[10px] uppercase tracking-[2px] text-primary">→</span>
            <span>Program lojalnościowy</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Team grid -->
  <section class="border-t border-border py-16">
    <p class="font-ui text-[11px] uppercase tracking-[3px] text-muted">Zespół</p>
    <h2 class="mt-3 font-display text-h2">Nasze specjalistki</h2>

    <div class="mt-12 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
      {
        sortedSpecialists.map((s) => (
          <div class="group">
            <!-- Photo / placeholder -->
            <div class="relative aspect-[3/4] overflow-hidden bg-surface">
              {s.data.photo ? (
                <img
                  src={s.data.photo}
                  alt={s.data.name}
                  class="h-full w-full object-cover grayscale transition-transform duration-500 group-hover:scale-105"
                />
              ) : (
                <div class="flex h-full w-full items-end p-5">
                  <span class="font-display text-[5rem] leading-none text-border">
                    {s.data.name.charAt(0)}
                  </span>
                </div>
              )}
            </div>

            <!-- Info -->
            <div class="mt-3">
              <p class="font-display text-xl">{s.data.name}</p>
              {locationName[s.data.locationSlug] && (
                <p class="mt-1 font-ui text-[10px] uppercase tracking-[2px] text-muted">
                  HB {locationName[s.data.locationSlug]}
                </p>
              )}
              {s.data.bio && (
                <p class="mt-2 text-sm leading-relaxed text-muted">{s.data.bio}</p>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-border py-16 text-center">
    <p class="font-ui text-[11px] uppercase tracking-[3px] text-muted">Gotowa?</p>
    <h2 class="mt-3 font-display text-h2">Zapraszamy</h2>
    <p class="mt-4 text-muted">
      Umów swoją pierwszą wizytę i przekonaj się sama.
    </p>
    <div class="mt-8">
      <BookingCTA
        url="https://booksy.com/pl-pl/111132_hey-beauty-2-0_salon-kosmetyczny_8820_krakow"
      />
    </div>
  </section>
</Page>
