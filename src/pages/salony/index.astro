---
import Page from "../../layouts/Page.astro";
import { getCollection } from "astro:content";
import LocationCard from "../../components/LocationCard.astro";

const locations = await getCollection("locations");
const sorted = locations.sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const title = "Salony Hey Beauty Kraków — 4 lokalizacje";
const description = "Salon kosmetyczny Hey Beauty w Krakowie. 4 lokalizacje: Śródmieście, Zabłocie i więcej. Sprawdź adresy, godziny otwarcia i zarezerwuj wizytę.";
const breadcrumbs = [
  { name: "Strona główna", url: "/" },
  { name: "Salony", url: "/salony/" },
];
---

<Page {title} {description} {breadcrumbs}>
  <section class="py-16 lg:py-24">
    <h1 class="font-display text-h1">Nasze salony</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Hey Beauty to 4 salony kosmetyczne w Krakowie. Każdy z nich oferuje
      profesjonalne zabiegi w luksusowej atmosferze.
    </p>
    <div class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        sorted.map((loc) => (
          <LocationCard
            name={loc.data.name}
            shortName={loc.data.shortName}
            slug={loc.data.slug}
            address={loc.data.address.street}
            district={loc.data.address.district}
            rating={loc.data.rating}
            booksyUrl={loc.data.booksyUrl}
          />
        ))
      }
    </div>
  </section>
</Page>
