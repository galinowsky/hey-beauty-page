---
import Page from "../../../layouts/Page.astro";
import { getCollection } from "astro:content";
import JsonLd from "../../../components/JsonLd.astro";
import BookingCTA from "../../../components/BookingCTA.astro";
import FAQAccordion from "../../../components/FAQAccordion.astro";
import {
  buildBeautySalon,
  buildService,
  buildFAQPage,
  buildBreadcrumbList,
} from "../../../lib/json-ld";
import { url } from "../../../utils/asset";

export async function getStaticPaths() {
  const allServiceLocations = await getCollection("serviceLocations");
  const locations = await getCollection("locations");
  const services = await getCollection("services");

  return allServiceLocations
    .filter((sl) => sl.data.available)
    .map((sl) => {
      const location = locations.find(
        (l) => l.data.slug === sl.data.locationSlug,
      );
      const service = services.find(
        (s) => s.data.slug === sl.data.serviceSlug,
      );
      return {
        params: {
          location: sl.data.locationSlug,
          service: sl.data.serviceSlug,
        },
        props: { serviceLocation: sl, location, service },
      };
    })
    .filter((p) => p.props.location && p.props.service);
}

const { serviceLocation, location, service } = Astro.props;

// Get FAQ for this service
const allFaq = await getCollection("faq");
const serviceFaq = allFaq.find(
  (f) => f.data.scope === "service" && f.data.scopeSlug === service!.data.slug,
);

// Get all locations offering this service (for comparison)
const allServiceLocations = await getCollection("serviceLocations");
const otherLocations = allServiceLocations.filter(
  (sl) => sl.data.serviceSlug === service!.data.slug && sl.data.available,
);
const allLocations = await getCollection("locations");

const title = `${service!.data.name} — ${location!.data.name} | Hey Beauty Kraków`;
const description = `${service!.data.name} w salonie ${location!.data.name}, ${location!.data.address.street}, Kraków. Cena od ${serviceLocation.data.price} zł. Umów wizytę online.`;
const breadcrumbs = [
  { name: "Strona główna", url: "/" },
  { name: "Salony", url: "/salony/" },
  {
    name: location!.data.shortName,
    url: `/salony/${location!.data.slug}/`,
  },
  { name: service!.data.name, url: Astro.url.pathname },
];
---

<Page {title} {description} {breadcrumbs}>
  <JsonLd slot="head" data={buildBeautySalon(location!.data)} />
  <JsonLd
    slot="head"
    data={buildService(service!.data, serviceLocation.data, location!.data)}
  />
  <JsonLd slot="head" data={buildBreadcrumbList(breadcrumbs, Astro.site)} />
  {
    serviceFaq && (
      <JsonLd slot="head" data={buildFAQPage(serviceFaq.data.items)} />
    )
  }

  <!-- Service header -->
  <section class="py-16 lg:py-24">
    <p class="font-ui text-[11px] uppercase tracking-[3px] text-muted">
      <span class="font-mono">{location!.data.shortName}</span> &middot;
      {service!.data.category}
    </p>
    <h1 class="mt-4 font-display text-h1">{service!.data.name}</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
      {service!.data.description}
    </p>

    <!-- Price & duration -->
    <div class="mt-8 flex gap-12">
      <div>
        <p class="font-ui text-[10px] uppercase tracking-[2px] text-muted">
          Cena
        </p>
        <p class="mt-1 font-display text-2xl">
          od {serviceLocation.data.price} zł
        </p>
        {
          serviceLocation.data.priceNote && (
            <p class="text-sm text-muted">{serviceLocation.data.priceNote}</p>
          )
        }
      </div>
      <div>
        <p class="font-ui text-[10px] uppercase tracking-[2px] text-muted">
          Czas zabiegu
        </p>
        <p class="mt-1 font-display text-2xl">
          {serviceLocation.data.duration} min
        </p>
      </div>
    </div>

    <BookingCTA
      url={serviceLocation.data.booksyDirectUrl || location!.data.booksyUrl}
      locationName={location!.data.name}
      serviceName={service!.data.name}
      class="mt-10"
    />
  </section>

  <!-- Available at other locations -->
  {
    otherLocations.length > 1 && (
      <section class="border-t border-border py-16">
        <h2 class="font-display text-h3">Porównaj ceny w salonach</h2>
        <div class="mt-8 divide-y divide-border">
          {otherLocations.map((sl) => {
            const loc = allLocations.find(
              (l) => l.data.slug === sl.data.locationSlug,
            );
            if (!loc) return null;
            const isCurrent =
              sl.data.locationSlug === location!.data.slug;
            return (
              <div
                class:list={[
                  "flex items-center justify-between py-4",
                  isCurrent && "font-medium",
                ]}
              >
                <div>
                  <span class="font-mono text-xs text-muted">
                    {loc.data.shortName}
                  </span>
                  <span class="ml-2">{loc.data.name}</span>
                  {isCurrent && (
                    <span class="ml-2 text-xs text-muted">(ten salon)</span>
                  )}
                </div>
                <div class="flex items-center gap-4">
                  <span class="font-ui text-sm">
                    od {sl.data.price} zł
                  </span>
                  {!isCurrent && (
                    <a
                      href={url(`/salony/${sl.data.locationSlug}/${service!.data.slug}/`)}
                      class="font-ui text-[10px] uppercase tracking-[2px] text-accent"
                    >
                      Sprawdź →
                    </a>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  {
    serviceFaq && (
      <section class="border-t border-border py-16">
        <h2 class="font-display text-h3">
          Często zadawane pytania o {service!.data.name.toLowerCase()}
        </h2>
        <div class="mt-8">
          <FAQAccordion items={serviceFaq.data.items} />
        </div>
      </section>
    )
  }

  <!-- Related services at this location -->
  <section class="border-t border-border py-16">
    <h2 class="font-display text-h3">
      Inne usługi w {location!.data.shortName}
    </h2>
    <p class="mt-2 text-sm text-muted">
      <a
        href={url(`/salony/${location!.data.slug}/`)}
        class="border-b border-accent text-accent"
      >
        Zobacz pełną ofertę salonu →
      </a>
    </p>
  </section>
</Page>
