---
import Page from "../layouts/Page.astro";
import { getCollection } from "astro:content";
import JsonLd from "../components/JsonLd.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import { buildFAQPage, buildBreadcrumbList } from "../lib/json-ld";

const faqEntries = await getCollection("faq");
const globalFaq = faqEntries.find((f) => f.data.scope === "global");
const allItems = faqEntries.flatMap((f) => f.data.items);

const title = "FAQ — Najczęściej Zadawane Pytania | Hey Beauty Kraków";
const description = "Odpowiedzi na najczęściej zadawane pytania o salonach Hey Beauty w Krakowie. Rezerwacje, usługi, lokalizacje i więcej.";
const breadcrumbs = [
  { name: "Strona główna", url: "/" },
  { name: "FAQ", url: "/faq/" },
];
---

<Page {title} {description} {breadcrumbs}>
  <JsonLd slot="head" data={buildFAQPage(allItems)} />
  <JsonLd slot="head" data={buildBreadcrumbList(breadcrumbs, Astro.site)} />

  <section class="py-16 lg:py-24">
    <h1 class="font-display text-h1">Najczęściej zadawane pytania</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Masz pytania? Znajdziesz tutaj odpowiedzi na najczęstsze zapytania o nasze salony i usługi.
    </p>
  </section>

  <section class="pb-24">
    <div class="mx-auto max-w-3xl">
      <FAQAccordion items={allItems} />
    </div>
  </section>
</Page>
