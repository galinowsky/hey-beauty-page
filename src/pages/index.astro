---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import JsonLd from "../components/JsonLd.astro";
import ServiceCard from "../components/ServiceCard.astro";
import LocationCard from "../components/LocationCard.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import BookingCTA from "../components/BookingCTA.astro";
import { buildOrganization } from "../lib/json-ld";
import { buildFAQPage } from "../lib/json-ld";
import { assetPath } from "../utils/asset";

const locations = await getCollection("locations");
const services = await getCollection("services");
const faqEntries = await getCollection("faq");

const sortedLocations = locations.sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);
const sortedServices = services.sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);

const globalFaq = faqEntries.find((f) => f.data.scope === "global");

const title =
  "Hey Beauty — Salon Kosmetyczny Kraków | Face · Body · Brows · Nails";
const description =
  "Hey Beauty to sieć salonów kosmetycznych w Krakowie. 4 lokalizacje, profesjonalne zabiegi na twarz i ciało, stylizacja brwi i rzęs, pedicure. Umów wizytę online.";
---

<Base {title} {description}>
  <JsonLd slot="head" data={buildOrganization()} />
  {
    globalFaq && (
      <JsonLd slot="head" data={buildFAQPage(globalFaq.data.items)} />
    )
  }

  <!-- HERO — Carousel with cross-fade + slow zoom -->
  <section class="hero-section relative flex min-h-[90vh] flex-col items-center justify-center overflow-hidden">
    <!-- Carousel slides -->
    {[
      { src: assetPath("/images/hero-salon.jpeg"),          alt: "Recepcja salonu Hey Beauty" },
      { src: assetPath("/images/inspiration-1.jpeg"),       alt: "Stylizacja paznokci Hey Beauty" },
      { src: assetPath("/images/locations/hey_beauty_2.avif"), alt: "Wnętrze salonu Hey Beauty 2.0" },
      { src: assetPath("/images/inspiration-2.jpeg"),       alt: "Zabiegi kosmetyczne Hey Beauty" },
    ].map((slide, i) => (
      <div
        class:list={["hero-slide absolute inset-0", i === 0 && "is-active"]}
        data-slide
      >
        <img
          src={slide.src}
          alt={slide.alt}
          class="h-full w-full object-cover"
          loading={i === 0 ? "eager" : "lazy"}
        />
      </div>
    ))}
    <!-- Shared dark overlay -->
    <div class="absolute inset-0 z-[1] bg-black/45"></div>

    <!-- Content -->
    <div class="relative z-10 px-6 text-center text-white" style="z-index:2">
      <img
        data-hero
        src={assetPath("/images/hey-beauty-logo.avif")}
        alt="Hey Beauty"
        class="mx-auto mt-8 h-24 w-auto invert md:mt-12 md:h-36"
      />
      <p data-hero-delay class="mt-8 font-ui text-sm uppercase tracking-[8px] text-white/70">
        Face &middot; Body &middot; Brows &middot; Nails &middot; Kraków
      </p>
      <div data-hero-delay-2 class="mt-16">
        <a
          href="https://booksy.com/pl-pl/111132_hey-beauty-2-0_salon-kosmetyczny_8820_krakow?utm_source=heybeauty-website&utm_medium=cta&utm_campaign=hero"
          target="_blank"
          rel="noopener"
          class="inline-block border border-white/60 px-10 py-4 font-ui text-[12px] uppercase tracking-[4px] text-white transition-all duration-300 hover:border-white hover:bg-white hover:text-black"
        >
          Umów wizytę
        </a>
      </div>
    </div>

    <!-- Carousel dots -->
    <div class="absolute bottom-8 left-1/2 z-10 flex -translate-x-1/2 gap-2" style="z-index:2" id="hero-dots">
      {[0,1,2,3].map((i) => (
        <button
          class:list={["hero-dot size-1.5 rounded-full transition-all duration-500", i === 0 ? "bg-white scale-125" : "bg-white/40"]}
          data-index={i}
          aria-label={`Slajd ${i + 1}`}
        />
      ))}
    </div>

    <p data-hero-delay-2 class="relative mt-auto pb-20 font-mono text-xs tracking-[2px] text-white/40" style="z-index:2">
      4 salony &middot;
      {sortedLocations.map((l) => l.data.shortName).join(" · ")}
    </p>
  </section>

  <script>
    const slides = document.querySelectorAll<HTMLElement>("[data-slide]");
    const dots = document.querySelectorAll<HTMLButtonElement>(".hero-dot");
    let current = 0;
    let timer: ReturnType<typeof setInterval>;

    function goTo(index: number) {
      slides[current].classList.remove("is-active");
      dots[current].classList.remove("bg-white", "scale-125");
      dots[current].classList.add("bg-white/40");
      current = index;
      slides[current].classList.add("is-active");
      dots[current].classList.add("bg-white", "scale-125");
      dots[current].classList.remove("bg-white/40");
    }

    function next() {
      goTo((current + 1) % slides.length);
    }

    timer = setInterval(next, 5000);

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        clearInterval(timer);
        goTo(i);
        timer = setInterval(next, 5000);
      });
    });
  </script>

  <!-- LOCATIONS -->
  <section class="grain bg-surface py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6">
      <div data-reveal>
        <p class="font-ui text-[11px] uppercase tracking-[4px] text-muted">
          Nasze Salony
        </p>
        <h2 class="mt-4 font-display text-h2">4 lokalizacje w Krakowie</h2>
      </div>
      <div
        data-reveal-stagger
        class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4"
      >
        {
          sortedLocations.map((loc) => (
            <LocationCard
              name={loc.data.name}
              shortName={loc.data.shortName}
              slug={loc.data.slug}
              address={loc.data.address.street}
              district={loc.data.address.district}
              rating={loc.data.rating}
              booksyUrl={loc.data.booksyUrl}
              image={loc.data.images[0]}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6">
      <div data-reveal>
        <p class="font-ui text-[11px] uppercase tracking-[4px] text-muted">
          Usługi
        </p>
        <h2 class="mt-4 font-display text-h2">Zabiegi kosmetyczne</h2>
      </div>
      <div
        data-reveal-stagger
        class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          sortedServices.map((s) => (
            <ServiceCard
              name={s.data.name}
              slug={s.data.slug}
              description={s.data.description}
              priceMin={s.data.priceRange.min}
              duration={`${s.data.duration.min} min`}
              image={s.data.image}
            />
          ))
        }
      </div>
      <div class="mt-12 text-center">
        <a
          href={url("/uslugi/")}
          class="inline-block border border-primary px-8 py-3 font-ui text-[11px] uppercase tracking-[3px] transition-colors hover:bg-primary hover:text-bg"
        >
          Zobacz wszystkie usługi
        </a>
      </div>
    </div>
  </section>

  <!-- ABOUT PREVIEW — asymmetric editorial layout -->
  <section class="grain bg-surface">
    <div class="mx-auto grid min-h-[600px] max-w-7xl grid-cols-1 md:grid-cols-[1.2fr_1fr]">
      <div data-reveal class="flex items-end p-12 pb-24 lg:p-20 lg:pb-32">
        <div>
          <p class="font-display text-[clamp(2.5rem,5vw,4rem)] italic leading-[1.05] text-primary/20">
            &ldquo;Your Care Place&rdquo;
          </p>
        </div>
      </div>
      <div data-reveal class="flex flex-col justify-center p-12 lg:p-20">
        <h2 class="font-display text-h2">O Hey Beauty</h2>
        <p class="mt-8 text-lg leading-relaxed text-muted">
          Sieć salonów kosmetycznych w Krakowie, łączących profesjonalizm
          z luksusową atmosferą. Pełen zakres usług, od stylizacji brwi i rzęs,
          przez zabiegi na twarz i ciało, po manicure i pedicure.
        </p>
        <a
          href={url("/o-nas/")}
          class="mt-10 inline-block self-start border-b border-primary pb-1 font-ui text-[11px] uppercase tracking-[3px]"
        >
          Poznaj nas bliżej →
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  {
    globalFaq && (
      <section class="py-24 lg:py-32">
        <div class="mx-auto max-w-3xl px-6">
          <div data-reveal class="text-center">
            <p class="font-ui text-[11px] uppercase tracking-[4px] text-muted">
              FAQ
            </p>
            <h2 class="mt-4 font-display text-h2">
              Najczęściej zadawane pytania
            </h2>
          </div>
          <div data-reveal class="mt-16">
            <FAQAccordion items={globalFaq.data.items} />
          </div>
        </div>
      </section>
    )
  }

  <!-- INSTAGRAM / SOCIAL PROOF -->
  <section class="bg-primary py-16 text-center text-bg">
    <p class="font-display text-h3">@heybeauty_krk</p>
    <p class="mt-2 font-ui text-sm text-bg/70">
      5,600+ obserwujących na Instagramie
    </p>
    <a
      href="https://instagram.com/heybeauty_krk"
      target="_blank"
      rel="noopener"
      class="mt-6 inline-block border border-bg/30 px-8 py-3 font-ui text-[11px] uppercase tracking-[3px] text-bg transition-colors hover:bg-bg hover:text-primary"
    >
      Obserwuj nas
    </a>
  </section>
</Base>
