---
import "../styles/global.css";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  hreflangPath?: string; // canonical path without locale prefix, e.g. "/uslugi/"
}

const { title, description, ogImage, canonical, hreflangPath } = Astro.props;
const lang = Astro.currentLocale ?? "pl";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Head {title} {description} {ogImage} {canonical} {hreflangPath}>
      <slot name="head" />
    </Head>
  </head>
  <body class="min-h-screen">
    <a href="#main-content" class="skip-nav">Przejdź do treści</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      // Global: stop container pulse when images load
      document.querySelectorAll<HTMLElement>('[data-media-container]').forEach(container => {
        const img = container.querySelector<HTMLImageElement>('img[data-media-item]');
        if (!img) return;
        const done = () => container.classList.replace('media-loading', 'media-loaded');
        if (img.complete && img.naturalHeight > 0) done();
        else img.addEventListener('load', done, { once: true });
      });

      // Mobile (< 768px): activate card hover effects on scroll into center
      if (window.innerWidth < 768) {
        const cards = document.querySelectorAll<HTMLElement>('[data-card]');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            const card = entry.target as HTMLElement;
            card.classList.toggle('is-active', entry.isIntersecting);
            // Toggle grayscale class on location card images for mobile scroll reveal
            if (card.tagName === 'DIV') {
              const img = card.querySelector<HTMLImageElement>('img[data-media-item]');
              if (img) img.classList.toggle('grayscale', !entry.isIntersecting);
            }
          });
        }, { threshold: 0.5, rootMargin: '-20% 0px -20% 0px' });
        cards.forEach(card => observer.observe(card));
      }
    </script>
  </body>
</html>
