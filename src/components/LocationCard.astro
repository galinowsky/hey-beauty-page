---
import { assetPath, url } from "../utils/asset";

interface Props {
  name: string;
  shortName: string;
  slug: string;
  address: string;
  district?: string;
  rating?: { value: number; count: number };
  booksyUrl: string;
  image?: string;
}

const { name, shortName, slug, address, district, rating, booksyUrl, image } =
  Astro.props;
---

<div class="hover-lift flex flex-col border border-border">
  <!-- Image -->
  <div class="aspect-[16/10] overflow-hidden bg-surface">
    {
      image ? (
        <img
          src={assetPath(image)}
          alt={name}
          class="h-full w-full object-cover img-reveal"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full flex-col items-center justify-center gap-2">
          <span class="font-mono text-3xl text-muted/30">{shortName}</span>
        </div>
      )
    }
  </div>

  <!-- Body -->
  <div class="flex flex-1 flex-col p-6 text-center">
    <span class="font-mono text-xs tracking-[2px] text-muted"
      >{shortName}</span
    >
    <h3 class="mt-1 font-display text-xl">{name}</h3>
    <p class="mt-2 text-sm text-muted">
      {address}
      {district && <span class="block text-xs">{district}</span>}
    </p>
    {
      rating && (
        <p class="mt-3 font-ui text-sm">
          {"★".repeat(Math.round(rating.value))} {rating.value.toFixed(1)}
          <span class="text-muted">({rating.count})</span>
        </p>
      )
    }
    <div class="mt-auto pt-4 flex gap-2">
      <a
        href={url(`/salony/${slug}/`)}
        class="flex-1 border border-primary py-2 font-ui text-[11px] uppercase tracking-[2px] text-primary transition-colors hover:bg-primary hover:text-bg"
      >
        Szczegóły
      </a>
      <a
        href={booksyUrl}
        target="_blank"
        rel="noopener"
        class="flex-1 bg-accent py-2 font-ui text-[11px] uppercase tracking-[2px] text-white transition-colors hover:bg-accent-hover"
      >
        Rezerwuj
      </a>
    </div>
  </div>
</div>
