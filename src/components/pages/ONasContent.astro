---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../Breadcrumbs.astro";
import BookingCTA from "../BookingCTA.astro";
import JsonLd from "../JsonLd.astro";
import { getCollection } from "astro:content";
import { useTranslations, localizePath, tc } from "../../i18n/utils";
import { assetPath } from "../../utils/asset";
import type { Lang } from "../../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const lp = (path: string) => localizePath(path, lang);

const specialists = await getCollection("specialists");
const locations = await getCollection("locations");

const featured = specialists
  .filter((s) => s.data.featured)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const locationName: Record<string, string> = Object.fromEntries(
  locations.map((l) => [l.data.slug, l.data.shortName]),
);

const title = t("about.pageTitle");
const description = t("about.pageDesc");
const breadcrumbs = [
  { name: t("breadcrumb.home"), url: lp("/") },
  { name: t("nav.about"), url: lp("/o-nas/") },
];

// JSON-LD Person structured data for featured specialists
const personJsonLd = {
  "@context": "https://schema.org",
  "@graph": featured
    .filter((s) => s.data.booksyStafferUrl)
    .map((s) => ({
      "@type": "Person",
      name: s.data.name,
      jobTitle: tc("specialists", s.data.slug, "specialty", lang) ?? s.data.specialty,
      worksFor: { "@type": "Organization", name: "Hey Beauty" },
      ...(s.data.booksyStafferUrl ? { sameAs: [s.data.booksyStafferUrl] } : {}),
    })),
};

const whyItems = [t("about.why1"), t("about.why2"), t("about.why3"), t("about.why4"), t("about.why5")];
---

<Base {title} {description} hreflangPath="/o-nas/">
  <JsonLd slot="head" data={personJsonLd} />

  <div class="mx-auto max-w-7xl px-6">
    <div class="pt-8">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </div>

  <!-- VIDEO HERO -->
  <section class="grain bg-surface">
    <div class="mx-auto grid min-h-[600px] max-w-7xl grid-cols-1 md:grid-cols-[1.2fr_1fr]">
      <div data-reveal class="relative overflow-hidden bg-surface" style="min-height: 400px;">
        <video
          src={assetPath("/videos/hb_team.mp4")}
          autoplay
          muted
          loop
          playsinline
          class="h-full w-full object-cover"
          style="min-height: 400px;"
          data-hero-video
        ></video>
        <div class="absolute inset-0 bg-black/20 transition-opacity duration-500" data-hero-overlay></div>
        <div class="absolute bottom-0 left-0 p-12 lg:p-20">
          <p class="font-display text-[clamp(2rem,4vw,3.5rem)] italic leading-[1.05] text-white/60">
            {t("home.aboutQuote")}
          </p>
        </div>
      </div>
      <div data-reveal class="flex flex-col justify-center px-6 py-10 md:p-12 lg:p-20">
        <p class="font-ui text-[11px] uppercase tracking-[3px] text-muted">{t("about.label")}</p>
        <h1 class="mt-3 font-display text-h1">Hey Beauty</h1>
        <p class="mt-6 text-lg leading-relaxed text-muted md:mt-8">{t("about.intro")}</p>
      </div>
    </div>
  </section>

  <!-- PHILOSOPHY + WHY US -->
  <section class="py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6">
      <div data-reveal class="grid grid-cols-1 gap-16 md:grid-cols-2">
        <div>
          <p class="font-ui text-[11px] uppercase tracking-[3px] text-muted">{t("about.philosophyLabel")}</p>
          <h2 class="mt-3 font-display text-h3">{t("about.philosophyTitle")}</h2>
          <p class="mt-4 leading-relaxed text-muted">{t("about.philosophyText")}</p>
        </div>
        <div>
          <p class="font-ui text-[11px] uppercase tracking-[3px] text-muted">{t("about.whyLabel")}</p>
          <h2 class="mt-3 font-display text-h3">{t("about.whyTitle")}</h2>
          <ul class="mt-4 space-y-3 text-muted">
            {whyItems.map((item, i) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 font-ui text-[10px] uppercase tracking-[2px] text-primary">
                  {i === 0 ? "★" : "→"}
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- TOP STYLISTKI -->
  <section class="grain bg-surface py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6">
      <div data-reveal>
        <p class="font-ui text-[11px] uppercase tracking-[4px] text-muted">{t("about.teamLabel")}</p>
        <h2 class="mt-4 font-display text-h2">{t("about.teamTitle")}</h2>
      </div>
      <div data-reveal-stagger class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {featured.map((s) => (
          <div class="group" data-card>
            <div class="media-loading relative aspect-[3/4] overflow-hidden bg-surface" data-media-container>
              {s.data.videoUrl && (
                <>
                  <video
                    data-hover-video
                    src={assetPath(s.data.videoUrl)}
                    poster={s.data.photo ? assetPath(s.data.photo) : undefined}
                    muted
                    loop
                    playsinline
                    preload="none"
                    class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                  ></video>
                  <div data-play-hint class="absolute bottom-3 right-3 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-black/40 backdrop-blur-sm transition-opacity duration-300 group-hover:opacity-0">
                    <svg class="h-3.5 w-3.5 text-white/80" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </div>
                </>
              )}
              {s.data.photo ? (
                <img
                  src={assetPath(s.data.photo)}
                  alt={s.data.name}
                  loading="lazy"
                  data-media-item
                  class:list={[
                    "h-full w-full object-cover transition-all duration-500",
                    s.data.videoUrl
                      ? "group-hover:opacity-0"
                      : "grayscale group-hover:grayscale-0",
                  ]}
                />
              ) : (
                <div class="flex h-full w-full items-end p-5">
                  <span class="font-display text-[5rem] leading-none text-border">
                    {s.data.name.charAt(0)}
                  </span>
                </div>
              )}
            </div>
            <div class="mt-5 px-1 md:mt-4 md:px-0">
              <p class="font-display text-xl">{s.data.name}</p>
              {s.data.specialty && (
                <p class="mt-1.5 font-ui text-[11px] uppercase tracking-[2px] text-muted">
                  {s.data.specialtyUrl ? (
                    <a href={lp(s.data.specialtyUrl)} class="transition-colors hover:text-primary">
                      {tc("specialists", s.data.slug, "specialty", lang) ?? s.data.specialty}
                    </a>
                  ) : (
                    tc("specialists", s.data.slug, "specialty", lang) ?? s.data.specialty
                  )}
                  {locationName[s.data.locationSlug] && (
                    <span> &middot; <a href={lp(`/salony/${s.data.locationSlug}/`)} class="transition-colors hover:text-primary">HB {locationName[s.data.locationSlug]}</a></span>
                  )}
                </p>
              )}
              {s.data.bio && (
                <p class="mt-3 text-sm leading-relaxed text-muted">
                  {tc("specialists", s.data.slug, "bio", lang) ?? s.data.bio}
                </p>
              )}
              {s.data.booksyStafferUrl && (
                <a
                  href={s.data.booksyStafferUrl}
                  target="_blank"
                  rel="noopener"
                  class="mt-5 inline-block border border-primary px-6 py-2.5 font-ui text-[11px] uppercase tracking-[3px] transition-colors hover:bg-primary hover:text-bg"
                >
                  {t("about.bookStylist")}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    // ── Hero video: pulse overlay while loading ──
    document.querySelectorAll<HTMLVideoElement>('[data-hero-video]').forEach(video => {
      const overlay = video.parentElement?.querySelector<HTMLElement>('[data-hero-overlay]');
      if (!overlay) return;
      if (video.readyState >= 3) return;
      overlay.classList.add('animate-hero-pulse');
      video.addEventListener('canplay', () => overlay.classList.remove('animate-hero-pulse'), { once: true });
    });

    // ── Media loading: stop container pulse when loaded ──
    document.querySelectorAll<HTMLElement>('[data-media-container]').forEach(container => {
      const media = container.querySelector<HTMLImageElement | HTMLVideoElement>('[data-media-item]');
      if (!media) {
        container.classList.remove('media-loading');
        return;
      }
      const done = () => container.classList.replace('media-loading', 'media-loaded');
      if (media instanceof HTMLImageElement) {
        if (media.complete && media.naturalHeight > 0) done();
        else media.addEventListener('load', done, { once: true });
      } else {
        if (media.readyState >= 3) done();
        else media.addEventListener('canplay', done, { once: true });
      }
    });

    // ── Specialist hover videos ──
    const videos = document.querySelectorAll<HTMLVideoElement>('[data-hover-video]');

    // Desktop/tablet: hover to play (harmless on touch devices)
    videos.forEach(video => {
      const card = video.closest('.group');
      card?.addEventListener('mouseenter', () => { video.play().catch(() => {}); });
      card?.addEventListener('mouseleave', () => { video.pause(); video.currentTime = 0; });
    });

    // Mobile (single-column < 768px): auto-play on scroll into view
    if (window.innerWidth < 768) {
      videos.forEach(video => {
        video.classList.remove('group-hover:opacity-100');
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          const video = entry.target as HTMLVideoElement;
          const photo = video.parentElement?.querySelector('img') as HTMLElement | null;
          const hint = video.parentElement?.querySelector('[data-play-hint]') as HTMLElement | null;
          if (entry.isIntersecting) {
            // Try to play; if blocked (Low Power Mode), keep photo visible
            video.play().then(() => {
              video.classList.remove('opacity-0');
              video.classList.add('opacity-100');
              if (photo) photo.classList.add('opacity-0');
              if (hint) hint.classList.add('opacity-0');
            }).catch(() => {
              // Autoplay blocked (Low Power Mode, data saver, etc.)
              // Keep photo and play hint visible — user can tap to play
            });
          } else {
            video.pause();
            video.currentTime = 0;
            video.classList.remove('opacity-100');
            video.classList.add('opacity-0');
            if (photo) photo.classList.remove('opacity-0');
            if (hint) hint.classList.remove('opacity-0');
          }
        });
      }, { threshold: 0.5 });

      videos.forEach(video => observer.observe(video));

      // Tap-to-play fallback: if autoplay is blocked, user can tap the card
      videos.forEach(video => {
        const card = video.closest('.group');
        const photo = video.parentElement?.querySelector('img') as HTMLElement | null;
        const hint = video.parentElement?.querySelector('[data-play-hint]') as HTMLElement | null;
        card?.addEventListener('click', () => {
          if (video.paused) {
            video.play().then(() => {
              video.classList.remove('opacity-0');
              video.classList.add('opacity-100');
              if (photo) photo.classList.add('opacity-0');
              if (hint) hint.classList.add('opacity-0');
            }).catch(() => {});
          } else {
            video.pause();
            video.classList.remove('opacity-100');
            video.classList.add('opacity-0');
            if (photo) photo.classList.remove('opacity-0');
            if (hint) hint.classList.remove('opacity-0');
          }
        });
      });
    }
  </script>

  <!-- CTA -->
  <section class="py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6 text-center">
      <div data-reveal>
        <p class="font-ui text-[11px] uppercase tracking-[3px] text-muted">{t("about.ctaLabel")}</p>
        <h2 class="mt-3 font-display text-h2">{t("about.ctaTitle")}</h2>
        <p class="mt-4 text-muted">{t("about.ctaText")}</p>
        <div class="mt-8">
          <BookingCTA url="https://booksy.com/pl-pl/111132_hey-beauty-2-0_salon-kosmetyczny_8820_krakow" />
        </div>
      </div>
    </div>
  </section>
</Base>
