---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../Breadcrumbs.astro";
import BookingCTA from "../BookingCTA.astro";
import { getCollection } from "astro:content";
import { useTranslations, localizePath } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const lp = (path: string) => localizePath(path, lang);

const specialists = await getCollection("specialists");
const locations = await getCollection("locations");

const sortedSpecialists = [...specialists].sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);
const locationName: Record<string, string> = Object.fromEntries(
  locations.map((l) => [l.data.slug, l.data.shortName]),
);

const title = t("about.pageTitle");
const description = t("about.pageDesc");
const breadcrumbs = [
  { name: t("breadcrumb.home"), url: lp("/") },
  { name: t("nav.about"), url: lp("/o-nas/") },
];

const whyItems = [t("about.why1"), t("about.why2"), t("about.why3"), t("about.why4"), t("about.why5")];
---

<Base {title} {description} hreflangPath="/o-nas/">
  <div class="mx-auto max-w-7xl px-6">
    <div class="pt-8">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Hero -->
    <section class="pb-12 pt-16 lg:pt-24">
      <p class="font-ui text-[11px] uppercase tracking-[3px] text-muted">{t("about.label")}</p>
      <h1 class="mt-3 font-display text-h1">Hey Beauty</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">{t("about.intro")}</p>
    </section>

    <!-- Philosophy + Why us -->
    <section class="border-t border-border py-16">
      <div class="grid grid-cols-1 gap-16 md:grid-cols-2">
        <div>
          <p class="font-ui text-[11px] uppercase tracking-[3px] text-muted">{t("about.philosophyLabel")}</p>
          <h2 class="mt-3 font-display text-h3">{t("about.philosophyTitle")}</h2>
          <p class="mt-4 leading-relaxed text-muted">{t("about.philosophyText")}</p>
        </div>
        <div>
          <p class="font-ui text-[11px] uppercase tracking-[3px] text-muted">{t("about.whyLabel")}</p>
          <h2 class="mt-3 font-display text-h3">{t("about.whyTitle")}</h2>
          <ul class="mt-4 space-y-3 text-muted">
            {whyItems.map((item, i) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 font-ui text-[10px] uppercase tracking-[2px] text-primary">
                  {i === 0 ? "★" : "→"}
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Team grid -->
    <section class="border-t border-border py-16">
      <p class="font-ui text-[11px] uppercase tracking-[3px] text-muted">{t("about.teamLabel")}</p>
      <h2 class="mt-3 font-display text-h2">{t("about.teamTitle")}</h2>
      <div class="mt-12 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
        {sortedSpecialists.map((s) => (
          <div class="group">
            <div class="relative aspect-[3/4] overflow-hidden bg-surface">
              {s.data.photo ? (
                <img
                  src={s.data.photo}
                  alt={s.data.name}
                  class="h-full w-full object-cover grayscale transition-transform duration-500 group-hover:scale-105"
                />
              ) : (
                <div class="flex h-full w-full items-end p-5">
                  <span class="font-display text-[5rem] leading-none text-border">
                    {s.data.name.charAt(0)}
                  </span>
                </div>
              )}
            </div>
            <div class="mt-3">
              <p class="font-display text-xl">{s.data.name}</p>
              {locationName[s.data.locationSlug] && (
                <p class="mt-1 font-ui text-[10px] uppercase tracking-[2px] text-muted">
                  HB {locationName[s.data.locationSlug]}
                </p>
              )}
              {s.data.bio && (
                <p class="mt-2 text-sm leading-relaxed text-muted">{s.data.bio}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-border py-16 text-center">
      <p class="font-ui text-[11px] uppercase tracking-[3px] text-muted">{t("about.ctaLabel")}</p>
      <h2 class="mt-3 font-display text-h2">{t("about.ctaTitle")}</h2>
      <p class="mt-4 text-muted">{t("about.ctaText")}</p>
      <div class="mt-8">
        <BookingCTA url="https://booksy.com/pl-pl/111132_hey-beauty-2-0_salon-kosmetyczny_8820_krakow" />
      </div>
    </section>
  </div>
</Base>
