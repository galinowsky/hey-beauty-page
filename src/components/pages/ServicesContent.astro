---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../Breadcrumbs.astro";
import { getCollection } from "astro:content";
import ServiceCard from "../ServiceCard.astro";
import { useTranslations, localizePath } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const lp = (path: string) => localizePath(path, lang);

const services = await getCollection("services");
const sorted = services.sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const breadcrumbs = [
  { name: t("services.breadHome"), url: lp("/") },
  { name: t("services.breadServices"), url: lp("/uslugi/") },
];
---

<Base title={t("services.pageTitle")} description={t("services.pageDesc")} hreflangPath="/uslugi/">
  <div class="mx-auto max-w-7xl px-6">
    <div class="pt-8">
      <Breadcrumbs items={breadcrumbs} />
    </div>
    <section class="py-16 lg:py-24">
      <h1 class="font-display text-h1">{t("services.title")}</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">{t("services.subtitle")}</p>
      <div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sorted.map((s) => (
          <ServiceCard name={s.data.name} slug={s.data.slug} description={s.data.description}
            priceMin={s.data.priceRange.min} duration={`${s.data.duration.min} ${t("common.min")}`}
            image={s.data.image} />
        ))}
      </div>
    </section>
  </div>
</Base>
