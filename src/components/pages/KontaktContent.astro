---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../Breadcrumbs.astro";
import { getCollection } from "astro:content";
import { useTranslations, localizePath } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const lp = (path: string) => localizePath(path, lang);

const locations = await getCollection("locations");
const sorted = locations.sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const title = t("contact.pageTitle");
const description = t("contact.pageDesc");
const breadcrumbs = [
  { name: t("breadcrumb.home"), url: lp("/") },
  { name: t("nav.contact"), url: lp("/kontakt/") },
];
---

<Base {title} {description} hreflangPath="/kontakt/">
  <div class="mx-auto max-w-7xl px-6">
    <div class="pt-8">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <section class="py-16 lg:py-24">
      <h1 class="font-display text-h1">{t("contact.heading")}</h1>
      <p class="mt-4 text-lg text-muted">{t("contact.intro")}</p>
    </section>

    <section class="pb-24">
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
        {sorted.map((loc) => (
          <div class="border border-border p-8">
            <span class="font-mono text-xs tracking-[2px] text-muted">
              {loc.data.shortName}
            </span>
            <h2 class="mt-2 font-display text-xl">{loc.data.name}</h2>
            <div class="mt-4 space-y-1 text-sm text-muted">
              <p>{loc.data.address.street}</p>
              <p>{loc.data.address.postalCode} {loc.data.address.city}</p>
              {loc.data.address.district && <p>{loc.data.address.district}</p>}
              {loc.data.phone && <p class="mt-2">{loc.data.phone}</p>}
            </div>
            {loc.data.openingHours.length > 0 && (
              <div class="mt-4 space-y-1">
                <p class="font-ui text-[10px] uppercase tracking-[2px] text-muted">
                  {t("contact.hours")}
                </p>
                {loc.data.openingHours.map((h) => (
                  <div class="flex justify-between text-sm max-w-xs">
                    <span class="text-muted">{h.dayOfWeek}</span>
                    <span>{h.opens} - {h.closes}</span>
                  </div>
                ))}
              </div>
            )}
            <a
              href={loc.data.booksyUrl}
              target="_blank"
              rel="noopener"
              class="mt-6 inline-block bg-accent px-6 py-2 font-ui text-[11px] uppercase tracking-[3px] text-white transition-colors hover:bg-accent-hover"
            >
              {t("contact.book")}
            </a>
          </div>
        ))}
      </div>
    </section>

    <section class="border-t border-border py-16 text-center">
      <h2 class="font-display text-h3">{t("contact.social")}</h2>
      <a
        href="https://instagram.com/heybeauty_krk"
        target="_blank"
        rel="noopener"
        class="mt-4 inline-block border-b border-accent font-ui text-sm text-accent"
      >
        @heybeauty_krk
      </a>
    </section>
  </div>
</Base>
