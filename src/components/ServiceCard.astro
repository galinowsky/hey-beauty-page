---
interface Props {
  name: string;
  slug: string;
  description: string;
  priceMin: number;
  duration: string;
  image?: string;
}

import { url } from "../utils/asset";
const { name, slug, description, priceMin, duration, image } = Astro.props;
---

<a href={url(`/uslugi/${slug}/`)} class="group block border border-border transition-shadow hover:shadow-sm">
  <!-- Image -->
  <div class="aspect-[4/3] overflow-hidden bg-surface">
    {
      image ? (
        <img
          src={image}
          alt={name}
          class="h-full w-full object-cover grayscale transition-all duration-500 group-hover:scale-105 group-hover:grayscale-0"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full items-center justify-center">
          <span class="font-display text-xl text-muted/40">{name}</span>
        </div>
      )
    }
  </div>

  <!-- Body -->
  <div class="p-6">
    <h3 class="font-display text-xl font-normal">{name}</h3>
    <p class="mt-2 line-clamp-2 text-sm text-muted">{description}</p>
    <div class="mt-4 flex items-baseline justify-between">
      <span class="font-ui text-sm font-medium">od {priceMin} zł</span>
      <span class="font-ui text-[11px] uppercase tracking-[2px] text-muted">
        {duration}
      </span>
    </div>
    <span class="mt-4 inline-block border-b border-accent pb-0.5 font-ui text-[11px] uppercase tracking-[3px] text-accent">
      Dowiedz się więcej →
    </span>
  </div>
</a>
