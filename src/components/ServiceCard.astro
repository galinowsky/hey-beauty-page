---
interface Props {
  name: string;
  slug: string;
  description: string;
  priceMin: number | null;
  duration: string;
  image?: string;
  href?: string;       // override URL (for locale-aware links)
  learnMoreText?: string;
}

import { url, assetPath } from "../utils/asset";
const { name, slug, description, priceMin, duration, image, href, learnMoreText = "Dowiedz się więcej →" } = Astro.props;
---

<a href={href ?? url(`/uslugi/${slug}/`)} class="group block border border-border transition-shadow hover:shadow-sm" data-card>
  <!-- Image -->
  <div class:list={["aspect-[4/3] overflow-hidden bg-surface", image && "media-loading"]} data-media-container>
    {
      image ? (
        <img
          src={assetPath(image)}
          alt={name}
          class="h-full w-full object-cover grayscale transition-all duration-500 group-hover:scale-105 group-hover:grayscale-0"
          loading="lazy"
          data-media-item
        />
      ) : (
        <div class="flex h-full items-center justify-center">
          <span class="font-display text-xl text-muted/40">{name}</span>
        </div>
      )
    }
  </div>

  <!-- Body -->
  <div class="p-6">
    <h3 class="font-display text-xl font-normal">{name}</h3>
    <p class="mt-2 line-clamp-2 text-sm text-muted">{description}</p>
    <div class="mt-4 flex items-baseline justify-between">
      <span class="font-ui text-sm font-medium">{priceMin !== null ? `od ${priceMin} zł` : "Cena indyw."}</span>
      <span class="font-ui text-[11px] uppercase tracking-[2px] text-muted">
        {duration}
      </span>
    </div>
    <span class="mt-4 inline-block border-b border-accent pb-0.5 font-ui text-[11px] uppercase tracking-[3px] text-accent">
      {learnMoreText}
    </span>
  </div>
</a>
