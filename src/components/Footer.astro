---
import { getCollection } from "astro:content";
import { url } from "../utils/asset";
import { useTranslations, localizePath, toCanonicalPlPath } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

const locations = await getCollection("locations");
const sortedLocations = locations.sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);

const categories = [
  { label: "Kosmetologia", href: "/uslugi/kosmetologia/" },
  { label: "Kosmetyka",    href: "/uslugi/kosmetyka/" },
  { label: "Włosy",        href: "/uslugi/wlosy/" },
];

const lang = (Astro.currentLocale ?? "pl") as Lang;
const t = useTranslations(lang);
const lp = (path: string) => localizePath(path, lang);

const plPath = toCanonicalPlPath(Astro.url.pathname, lang);
const langLinks = [
  { code: "pl", label: "PL", href: localizePath(plPath, "pl") },
  { code: "en", label: "EN", href: localizePath(plPath, "en") },
  { code: "uk", label: "УК", href: localizePath(plPath, "uk") },
];
---

<footer class="border-t border-border">
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-6 py-16 sm:grid-cols-2 lg:grid-cols-4"
  >
    <!-- Brand -->
    <div>
      <p class="font-display text-2xl">Hey Beauty</p>
      <p class="mt-2 font-ui text-xs uppercase tracking-[3px] text-muted">
        Face &middot; Body &middot; Brows &middot; Nails
      </p>
      <p class="mt-6 text-sm leading-relaxed text-muted">
        {t("footer.brand")}
      </p>
      <div class="mt-4 font-mono text-xs text-muted">
        {sortedLocations.map((l) => l.data.shortName).join(" · ")}
      </div>
    </div>

    <!-- Services -->
    <div>
      <h4 class="mb-6 font-ui text-xs uppercase tracking-[3px] text-muted">
        {t("footer.services")}
      </h4>
      <ul class="space-y-2">
        {
          categories.map((cat) => (
            <li>
              <a
                href={lp(cat.href)}
                class="text-sm text-muted transition-colors hover:text-primary"
              >
                {cat.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={lp("/cennik/")}
            class="text-sm text-muted transition-colors hover:text-primary"
          >
            {t("nav.pricing")}
          </a>
        </li>
      </ul>
    </div>

    <!-- Locations -->
    <div>
      <h4 class="mb-6 font-ui text-xs uppercase tracking-[3px] text-muted">
        {t("footer.salons")}
      </h4>
      <ul class="space-y-2">
        {
          sortedLocations.map((l) => (
            <li>
              <a
                href={url(`/salony/${l.data.slug}/`)}
                class="text-sm text-muted transition-colors hover:text-primary"
              >
                {l.data.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Contact / Legal -->
    <div>
      <h4 class="mb-6 font-ui text-xs uppercase tracking-[3px] text-muted">
        {t("footer.contact")}
      </h4>
      <ul class="space-y-2 text-sm text-muted">
        <li>
          <a
            href="https://instagram.com/heybeauty_krk"
            target="_blank"
            rel="noopener"
            class="transition-colors hover:text-primary"
          >
            Instagram: @heybeauty_krk
          </a>
        </li>
        <li>
          <a href={url("/kontakt/")} class="transition-colors hover:text-primary">
            {t("footer.contact")}
          </a>
        </li>
        <li>
          <a
            href={url("/polityka-prywatnosci/")}
            class="transition-colors hover:text-primary"
          >
            {t("footer.privacy")}
          </a>
        </li>
        <li>
          <a href={url("/regulamin/")} class="transition-colors hover:text-primary">
            {t("footer.terms")}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Bottom bar -->
  <div
    class="mx-auto flex max-w-7xl items-center justify-between border-t border-border px-6 py-6 text-xs text-muted"
  >
    <span>&copy; {new Date().getFullYear()} Hey Beauty</span>
    <div class="flex items-center gap-1">
      {langLinks.map(({ code, label, href }) => (
        <a
          href={href}
          class:list={[
            "px-2 py-1 font-ui text-[10px] uppercase tracking-[2px] transition-colors",
            lang === code ? "text-primary" : "text-muted hover:text-primary",
          ]}
        >
          {label}
        </a>
      ))}
    </div>
  </div>
</footer>
